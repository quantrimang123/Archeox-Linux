#!/bin/bash

# ARCHEOX:summary=Update ARCHEOX and system packages
# ARCHEOX:args=[-y]
# ARCHEOX:examples=ARCHEOX update | ARCHEOX update -y
# ARCHEOX:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $ARCHEOX_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env ARCHEOX_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/ARCHEOX-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://ARCHEOX.org/discord\033[0m"' ERR

if [[ $1 == "-y" ]] || ARCHEOX-update-confirm; then
  ARCHEOX-snapshot create || (($? == 127))
  ARCHEOX-update-git
  ARCHEOX-update-perform
fi
