#!/bin/bash

# archeox:summary=Restore the default archeox Plymouth boot theme and SDDM login screen
# archeox:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/archeox"

sudo find ~/.local/share/archeox/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme archeox

if archeox-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

archeox-refresh-sddm
