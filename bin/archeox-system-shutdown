#!/bin/bash

# archeox:summary=Shut down after closing application windows
# archeox:examples=archeox shutdown | archeox system shutdown
# archeox:aliases=archeox shutdown

archeox-state clear re*-required

# Schedule the shutdown to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && systemctl poweroff --no-wall" >/dev/null 2>&1 &

# Now close all windows
archeox-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
