#!/bin/bash

# Archeox:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# Archeox:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
Archeox-pkg-add heroic-games-launcher-bin
Archeox-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &
