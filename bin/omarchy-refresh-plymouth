#!/bin/bash

# ILV:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the ILV default and rebuild it.
# ILV:requires-sudo=true

sudo cp -r ~/.local/share/ILV/default/plymouth/* /usr/share/plymouth/themes/ILV/
sudo plymouth-set-default-theme ILV

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
