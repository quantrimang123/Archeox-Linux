#!/bin/bash

# ILV:summary=Restore the default ILV Plymouth boot theme and SDDM login screen
# ILV:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/ILV"

sudo find ~/.local/share/ILV/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme ILV

if ILV-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

ILV-refresh-sddm
