#!/bin/bash

# ILV:summary=Update ILV and system packages
# ILV:args=[-y]
# ILV:examples=ILV update | ILV update -y
# ILV:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $ILV_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env ILV_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/ILV-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://ILV.org/discord\033[0m"' ERR

if [[ $1 == "-y" ]] || ILV-update-confirm; then
  ILV-snapshot create || (($? == 127))
  ILV-update-git
  ILV-update-perform
fi
