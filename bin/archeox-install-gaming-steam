#!/bin/bash

# Archeox:summary=Install Steam and graphics drivers selected for this system
# Archeox:requires-sudo=true

set -e

echo "Installing Steam..."
Archeox-pkg-add steam
Archeox-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &
