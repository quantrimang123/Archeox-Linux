#!/bin/bash

# ILV:summary=Run the full ILV update pipeline
# ILV:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
ILV-update-keyring
ILV-update-available-reset
ILV-update-system-pkgs
ILV-migrate
ILV-update-aur-pkgs
ILV-update-orphan-pkgs
ILV-hook post-update

ILV-update-analyze-logs

ILV-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
