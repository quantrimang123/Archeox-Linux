#!/bin/bash

# ARCHEOX:summary=Apply an ARCHEOX theme
# ARCHEOX:args=<theme-name>
# ARCHEOX:examples=ARCHEOX theme list | ARCHEOX theme set "Tokyo Night"

if [[ -z $1 ]]; then
  echo "Usage: ARCHEOX-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/ARCHEOX/current/theme"
NEXT_THEME_PATH="$HOME/.config/ARCHEOX/current/next-theme"
USER_THEMES_PATH="$HOME/.config/ARCHEOX/themes"
ARCHEOX_THEMES_PATH="$ARCHEOX_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $ARCHEOX_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$ARCHEOX_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate colors.toml from alacritty.toml if theme is missing colors.toml
if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  ARCHEOX-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

# Generate dynamic configs
ARCHEOX-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/ARCHEOX/current/theme.name"

# Change background with theme
if [[ $ARCHEOX_THEME_SKIP_BACKGROUND != "1" ]]; then
  ARCHEOX-theme-bg-next
fi

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  ARCHEOX-restart-waybar
fi
ARCHEOX-restart-swayosd
ARCHEOX-restart-terminal
ARCHEOX-restart-hyprctl
ARCHEOX-restart-btop
ARCHEOX-restart-opencode
ARCHEOX-restart-mako
ARCHEOX-restart-helix

# Change app-specific themes
ARCHEOX-theme-set-foot
ARCHEOX-theme-set-gnome
ARCHEOX-theme-set-browser
ARCHEOX-theme-set-vscode
ARCHEOX-theme-set-obsidian
ARCHEOX-theme-set-keyboard

# Call hook on theme set
ARCHEOX-hook theme-set "$THEME_NAME" >/dev/null
