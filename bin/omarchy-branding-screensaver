#!/bin/bash

# ILV:summary=Edit, set, or reset screensaver branding
# ILV:group=branding
# ILV:name=screensaver
# ILV:args=<image|text|reset>
# ILV:examples=ILV branding screensaver image | ILV branding screensaver text | ILV branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(ILV-menu-file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] && ILV-transcode-ascii "$image" ~/.config/ILV/branding/screensaver.txt; then
    ILV-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  ILV-launch-editor ~/.config/ILV/branding/screensaver.txt >/dev/null 2>&1 && ILV-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$OMARCHY_PATH/logo.txt" ~/.config/ILV/branding/screensaver.txt && ILV-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: ILV-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
