#!/bin/bash

# Archeox:summary=Reboot after closing application windows
# Archeox:examples=Archeox reboot | Archeox system reboot
# Archeox:aliases=Archeox reboot

Archeox-state clear re*-required

# Schedule the reboot to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 &

# Now close all windows
Archeox-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
