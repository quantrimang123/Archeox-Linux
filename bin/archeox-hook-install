#!/bin/bash

# archeox:summary=Install a hook into ~/.config/archeox/hooks/<type>.d/
# archeox:group=hook
# archeox:name=install
# archeox:args=<type> <file>
# archeox:examples=archeox hook install post-update ~/my-hook

set -e

if (( $# != 2 )); then
  echo "Usage: archeox-hook-install <type> <file>"
  exit 1
fi

HOOK_TYPE=$1
HOOK_FILE=$2
HOOK_DIR="$HOME/.config/archeox/hooks/$HOOK_TYPE.d"
HOOK_NAME=$(basename "$HOOK_FILE")
HOOK_PATH="$HOOK_DIR/$HOOK_NAME"

if [[ ! -f $HOOK_FILE ]]; then
  echo "Hook file not found: $HOOK_FILE"
  exit 1
fi

mkdir -p "$HOOK_DIR"
cp "$HOOK_FILE" "$HOOK_PATH"
chmod 755 "$HOOK_PATH"

echo "Installed $HOOK_TYPE hook: $HOOK_PATH"
