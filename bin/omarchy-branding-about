#!/bin/bash

# ILV:summary=Edit, set, or reset About branding
# ILV:group=branding
# ILV:name=about
# ILV:args=<image|text|reset>
# ILV:examples=ILV branding about image | ILV branding about text | ILV branding about reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(ILV-menu-file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] && ILV-transcode-ascii "$image" ~/.config/ILV/branding/about.txt --width 54 --height 26 --mode block; then
    ILV-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  ILV-launch-editor ~/.config/ILV/branding/about.txt >/dev/null 2>&1 && ILV-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$ILV_PATH/icon.txt" ~/.config/ILV/branding/about.txt && ILV-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: ILV-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
