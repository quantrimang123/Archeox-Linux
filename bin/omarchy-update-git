#!/bin/bash

# ARCHEOX:summary=Pull the latest ARCHEOX git changes

set -e

echo -e "\e[32mUpdate ARCHEOX\e[0m"

ARCHEOX-update-time

# Suppress Hyprland config errors while git updates default config files mid-pull
hyprctl keyword debug:suppress_errors true &>/dev/null || true

git -C $ARCHEOX_PATH pull --autostash
git -C $ARCHEOX_PATH --no-pager diff --check || git -C $ARCHEOX_PATH reset --merge

hyprctl reload &>/dev/null || true
