#!/bin/bash

# ILV:summary=Pull the latest ILV git changes

set -e

echo -e "\e[32mUpdate ILV\e[0m"

ILV-update-time

# Suppress Hyprland config errors while git updates default config files mid-pull
hyprctl keyword debug:suppress_errors true &>/dev/null || true

git -C $ILV_PATH pull --autostash
git -C $ILV_PATH --no-pager diff --check || git -C $ILV_PATH reset --merge

hyprctl reload &>/dev/null || true
