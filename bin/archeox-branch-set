#!/bin/bash

# Archeox:summary=Set the branch for Archeox's git repository.
# Archeox:args=<master|rc|dev>

if (($# == 0)); then
  echo "Usage: Archeox-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $Archeox_PATH switch $branch
