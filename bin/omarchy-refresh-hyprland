#!/bin/bash

# ILV:summary=Overwrite all the user configs in ~/.config/hypr with the Omarchy defaults.

ILV-refresh-config hypr/autostart.conf
ILV-refresh-config hypr/bindings.conf
ILV-refresh-config hypr/input.conf
ILV-refresh-config hypr/looknfeel.conf
ILV-refresh-config hypr/hyprland.conf
ILV-refresh-config hypr/monitors.conf
bash "$OMARCHY_PATH/install/config/detect-keyboard-layout.sh"
