#!/bin/bash

# ILV:summary=Set the Omarchy channel, which dictates what git branch and package repository is used.
# ILV:args=<stable|rc|edge|dev>
# ILV:requires-sudo=true

if (($# == 0)); then
  echo "Usage: ILV-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") ILV-branch-set "master" && ILV-refresh-pacman "stable" ;;
"rc") ILV-branch-set "rc" && ILV-refresh-pacman "rc" ;;
"edge") ILV-branch-set "master" && ILV-refresh-pacman "edge" ;;
"dev") ILV-branch-set "dev" && ILV-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

ILV-update -y
