#!/bin/bash

# ILV:summary=Display brightness level using SwayOSD on the current monitor.
# ILV:args=<0-100>
# ILV:examples=ILV swayosd brightness 0 | ILV swayosd brightness 50 | ILV swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

ILV-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
