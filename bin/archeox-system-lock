#!/bin/bash

# archeox:summary=Lock the computer and turn off the display
# archeox:group=system
# archeox:name=lock
# archeox:examples=archeox system lock

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    archeox-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.archeox.screensaver

if [[ ${archeox_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    archeox-brightness-keyboard off
    archeox-brightness-display off
  ) &
fi
