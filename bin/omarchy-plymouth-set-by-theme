#!/bin/bash

# ILV:summary=Set the Plymouth boot theme from an ILV theme
# ILV:args=<theme-name>
# ILV:requires-sudo=true

# Resolve a theme by name and apply its unlock.png + colors.toml as the
# Plymouth boot screen via ILV-plymouth-set.

if [[ $# -ne 1 ]]; then
  echo "Usage: ILV-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

theme=$1

if [[ -d ~/.config/ILV/themes/$theme ]]; then
  theme_dir=~/.config/ILV/themes/$theme
else
  theme_dir="$ILV_PATH/themes/$theme"
fi

bg=$(awk -F'"' '/^background/{print $2}' "$theme_dir/colors.toml")
text=$(awk -F'"' '/^foreground/{print $2}' "$theme_dir/colors.toml")

exec ILV-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
