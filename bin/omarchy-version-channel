#!/bin/bash

# ILV:summary=Print the active Omarchy mirror and package channel

if grep -q "https://stable-mirror.ILV.org/" /etc/pacman.d/mirrorlist; then
  mirror="stable"
elif grep -q "https://rc-mirror.ILV.org/" /etc/pacman.d/mirrorlist; then
  mirror="rc"
elif grep -q "https://mirror.ILV.org/" /etc/pacman.d/mirrorlist; then
  mirror="edge"
else
  mirror="unknown"
fi

if grep -q "https://pkgs.ILV.org/stable/" /etc/pacman.conf; then
  pkgs="stable"
elif grep -q "https://pkgs.ILV.org/edge/" /etc/pacman.conf; then
  pkgs="edge"
elif grep -q "https://pkgs.ILV.org/rc/" /etc/pacman.conf; then
  pkgs="rc"
else
  pkgs="unknown"
fi

if [[ $mirror == $pkgs ]]; then
  echo $mirror
else
  echo "$mirror / $pkgs"
fi
