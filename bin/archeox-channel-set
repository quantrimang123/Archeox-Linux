#!/bin/bash

# archeox:summary=Set the archeox channel, which dictates what git branch and package repository is used.
# archeox:args=<stable|rc|edge|dev>
# archeox:requires-sudo=true

if (($# == 0)); then
  echo "Usage: archeox-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") archeox-branch-set "master" && archeox-refresh-pacman "stable" ;;
"rc") archeox-branch-set "rc" && archeox-refresh-pacman "rc" ;;
"edge") archeox-branch-set "master" && archeox-refresh-pacman "edge" ;;
"dev") archeox-branch-set "dev" && archeox-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

archeox-update -y
