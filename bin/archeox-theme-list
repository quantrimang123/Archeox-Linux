#!/bin/bash

# archeox:summary=List available themes
# archeox:examples=archeox theme list | archeox theme set "Tokyo Night"

{
  find ~/.config/archeox/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$ARCHEOX_"PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
