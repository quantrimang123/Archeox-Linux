#!/bin/bash

# archeox:summary=Manage persistent state files for archeox toggles and settings.
# archeox:args=<set|clear> <state-name-or-pattern>
# archeox:hidden=true

STATE_DIR="$HOME/.local/state/archeox"
mkdir -p "$STATE_DIR"

COMMAND="$1"
STATE_NAME="$2"

if [[ -z $COMMAND ]]; then
  echo "Usage: archeox-state <set|clear> <state-name-or-pattern>"
  exit 1
fi

if [[ -z $STATE_NAME ]]; then
  echo "Usage: archeox-state $COMMAND <state-name>"
  exit 1
fi

case "$COMMAND" in
set) touch "$STATE_DIR/$STATE_NAME" ;;
clear) find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete ;;
esac
