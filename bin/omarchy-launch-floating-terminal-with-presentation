#!/bin/bash

# ARCHEOX:summary=Launch a floating terminal with the ARCHEOX presentation wrapper
# ARCHEOX:args=<command>

cmd="$*"
exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.ARCHEOX.terminal --title=ARCHEOX -e bash -c "ARCHEOX-show-logo; $cmd; if (( \$? != 130 )); then ARCHEOX-show-done; fi"
