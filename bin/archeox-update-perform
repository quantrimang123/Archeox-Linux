#!/bin/bash

# archeox:summary=Run the full archeox update pipeline
# archeox:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
archeox-update-keyring
archeox-update-available-reset
archeox-update-system-pkgs
archeox-migrate
archeox-update-aur-pkgs
archeox-update-orphan-pkgs
archeox-hook post-update

archeox-update-analyze-logs

archeox-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
