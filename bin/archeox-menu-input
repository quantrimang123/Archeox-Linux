#!/bin/bash

# archeox:summary=Prompt for text input with Walker
# archeox:group=menu
# archeox:name=input
# archeox:args=prompt [walker args...]
# archeox:examples=archeox menu input Reminder|archeox-menu-input "Reminder in minutes" --width 400

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

archeox-launch-walker --dmenu --inputonly --width 295 --minheight 1 --maxheight 1 -p "$prompt…" "$@" 2>/dev/null
