#!/bin/bash

# ILV:summary=Reinstall the ILV source directory from git

set -e

# Reinstall the ILV configuration directory from the git source.

git clone --depth=1 --branch master "https://github.com/basecamp/ILV.git" ~/.local/share/ILV-new >/dev/null
mv $ILV_PATH ~/.local/share/ILV-old
mv ~/.local/share/ILV-new $ILV_PATH
