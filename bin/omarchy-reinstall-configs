#!/bin/bash

# ILV:summary=Reset all Omarchy user configs to the defaults
# ILV:requires-sudo=true

set -e

# Overwrite all user configs with the Omarchy defaults.

if (( EUID == 0 )); then
  echo "Error: This script should not be run as root"
  exit 1
fi

echo "Resetting all Omarchy configs"
cp -R ~/.local/share/ILV/config/* ~/.config/
cp ~/.local/share/ILV/default/bashrc ~/.bashrc
echo '[[ -f ~/.bashrc ]] && . ~/.bashrc' | tee ~/.bash_profile >/dev/null

$(bash $ILV_PATH/install/config/theme.sh)

ILV-refresh-limine
ILV-refresh-plymouth
ILV-nvim-setup
