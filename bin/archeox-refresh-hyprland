#!/bin/bash

# archeox:summary=Overwrite all the user configs in ~/.config/hypr with the archeox defaults.

archeox-refresh-config hypr/autostart.conf
archeox-refresh-config hypr/bindings.conf
archeox-refresh-config hypr/input.conf
archeox-refresh-config hypr/looknfeel.conf
archeox-refresh-config hypr/hyprland.conf
archeox-refresh-config hypr/monitors.conf
bash "$ARCHEOX_"PATH/install/config/detect-keyboard-layout.sh"
