{
  // Omarchy menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. Use provider:"name" only when the submenu
  // calls provider_name() or a command named "name" to return JSON rows.
  // Optional fields:
  //   aliases        alternate `omarchy menu summon <name>` routes; also searchable
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"archeox-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"archeox-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"archeox-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! archeox-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"archeox-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"archeox-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"archeox-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"archeox-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"archeox-menu-keybindings"},
  "learn.omarchy": {"icon":"","label":"Omarchy","action":"archeox-launch-webapp 'https://learn.omacom.io/2/the-archeox-manual'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"archeox-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"archeox-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"archeox-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"archeox-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"archeox-menu-tmux-keybindings"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"archeox-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"archeox-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"archeox-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"archeox-capture-text"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"archeox-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"archeox-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"archeox-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"archeox-hw-webcam","action":"archeox-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"archeox-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"archeox-hw-laptop","action":"archeox-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"archeox-hw-laptop","action":"archeox-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"archeox-hw-hybrid-gpu","action":"archeox-launch-floating-terminal-with-presentation archeox-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"archeox-hw-touchpad","action":"archeox-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"archeox-hw-dell-xps-haptic-touchpad && archeox-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"archeox-hw-dell-xps-haptic-touchpad && archeox-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"archeox-hw-dell-xps-haptic-touchpad && archeox-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"archeox-hw-touchscreen","action":"archeox-toggle-touchscreen"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"archeox-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"archeox-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"archeox-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"archeox-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"xdg-terminal-exec --app-id=org.omarchy.terminal bash -c 'archeox-menu-share file'"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"xdg-terminal-exec --app-id=org.omarchy.terminal bash -c 'archeox-menu-share folder'"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"archeox-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"archeox-toggle-notification-silencing"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"archeox-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"archeox-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"archeox-toggle-bar"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"archeox-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"archeox-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"archeox-hyprland-window-single-square-aspect-toggle"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(archeox-theme-switcher); [[ -n $theme ]] && archeox-theme-set \"$theme\""},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(archeox-plymouth-switcher); if [[ $unlock == default ]]; then archeox-launch-floating-terminal-with-presentation archeox-plymouth-reset; elif [[ -n $unlock ]]; then archeox-launch-floating-terminal-with-presentation \"archeox-plymouth-set-by-theme '$unlock'\"; fi"},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(archeox-theme-bg-switcher); [[ -n $background ]] && archeox-theme-bg-set \"$background\""},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"archeox-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"archeox-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
  "style.install": {"icon":"󰉉","label":"Install"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"archeox-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"archeox-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"archeox-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"archeox-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"archeox-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"archeox-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"archeox-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"archeox-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"archeox-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"archeox-branding-screensaver reset"},
  "style.install.theme": {"icon":"󰸌","label":"Theme","action":"archeox-launch-floating-terminal-with-presentation archeox-theme-install"},
  "style.install.background": {"icon":"","label":"Background","action":"archeox-theme-bg-install"},
  "style.install.font": {"icon":"","label":"Font"},
  "style.install.font.cascadia": {"icon":"","label":"Cascadia Mono","action":"archeox-install-font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'"},
  "style.install.font.meslo": {"icon":"","label":"Meslo LG Mono","action":"archeox-install-font 'Meslo LG Mono' ttf-meslo-nerd 'MesloLGL Nerd Font'"},
  "style.install.font.fira": {"icon":"","label":"Fira Code","action":"archeox-install-font 'Fira Code' ttf-firacode-nerd 'FiraCode Nerd Font'"},
  "style.install.font.victor": {"icon":"","label":"Victor Code","action":"archeox-install-font 'Victor Code' ttf-victor-mono-nerd 'VictorMono Nerd Font'"},
  "style.install.font.bitstream": {"icon":"","label":"Bitstream Vera Mono","action":"archeox-install-font 'Bitstream Vera Code' ttf-bitstream-vera-mono-nerd 'BitstromWera Nerd Font'"},
  "style.install.font.iosevka": {"icon":"","label":"Iosevka","action":"archeox-install-font Iosevka ttf-iosevka-nerd 'Iosevka Nerd Font Mono'"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"archeox-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"archeox-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"archeox-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.direct-boot": {"icon":"","label":"Direct Boot","action":"archeox-launch-floating-terminal-with-presentation archeox-setup-direct-boot"},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(archeox-dns)\" == \"DHCP\" ]]","action":"archeox-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(archeox-dns)\" == \"Cloudflare\" ]]","action":"archeox-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(archeox-dns)\" == \"Google\" ]]","action":"archeox-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(archeox-dns)\" == \"Custom\" ]]","action":"archeox-launch-floating-terminal-with-presentation 'archeox-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(archeox-network-status) == wifi* ]]","action":"archeox-shell omarchy.network showQr"},
  "setup.network.speedtest": {"icon":"󰓅","label":"Speed Test","aliases":["speedtest","speed-test"],"action":"archeox-shell omarchy.network speedTest"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.browser": {"icon":"","label":"Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"archeox-cmd-present chromium","checked":"[[ \"$(archeox-default-browser)\" == \"chromium\" ]]","action":"archeox-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"archeox-cmd-present google-chrome-stable","checked":"[[ \"$(archeox-default-browser)\" == \"chrome\" ]]","action":"archeox-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"archeox-cmd-present brave","checked":"[[ \"$(archeox-default-browser)\" == \"brave\" ]]","action":"archeox-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","when":"archeox-cmd-present brave-origin","checked":"[[ \"$(archeox-default-browser)\" == \"brave-origin\" ]]","action":"archeox-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"archeox-cmd-present microsoft-edge-stable","checked":"[[ \"$(archeox-default-browser)\" == \"edge\" ]]","action":"archeox-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"archeox-cmd-present firefox","checked":"[[ \"$(archeox-default-browser)\" == \"firefox\" ]]","action":"archeox-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"archeox-cmd-present zen-browser","checked":"[[ \"$(archeox-default-browser)\" == \"zen\" ]]","action":"archeox-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"archeox-cmd-present alacritty","checked":"[[ \"$(archeox-default-terminal)\" == \"alacritty\" ]]","action":"archeox-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"archeox-cmd-present foot","checked":"[[ \"$(archeox-default-terminal)\" == \"foot\" ]]","action":"archeox-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"archeox-cmd-present ghostty","checked":"[[ \"$(archeox-default-terminal)\" == \"ghostty\" ]]","action":"archeox-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"archeox-cmd-present kitty","checked":"[[ \"$(archeox-default-terminal)\" == \"kitty\" ]]","action":"archeox-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","when":"archeox-cmd-present nvim","checked":"[[ \"$(archeox-default-editor)\" == \"nvim\" ]]","action":"archeox-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","when":"archeox-cmd-present code","checked":"[[ \"$(archeox-default-editor)\" == \"code\" ]]","action":"archeox-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","label":"Cursor","when":"archeox-cmd-present cursor","checked":"[[ \"$(archeox-default-editor)\" == \"cursor\" ]]","action":"archeox-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","when":"archeox-cmd-present zeditor","checked":"[[ \"$(archeox-default-editor)\" == \"zeditor\" ]]","action":"archeox-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"archeox-cmd-present sublime_text","checked":"[[ \"$(archeox-default-editor)\" == \"sublime_text\" ]]","action":"archeox-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"archeox-cmd-present helix","checked":"[[ \"$(archeox-default-editor)\" == \"helix\" ]]","action":"archeox-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"archeox-cmd-present vim","checked":"[[ \"$(archeox-default-editor)\" == \"vim\" ]]","action":"archeox-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"archeox-cmd-present emacs","checked":"[[ \"$(archeox-default-editor)\" == \"emacs\" ]]","action":"archeox-default-editor emacs"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"archeox-hw-fingerprint","action":"archeox-launch-floating-terminal-with-presentation archeox-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"archeox-launch-floating-terminal-with-presentation archeox-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"archeox-launch-floating-terminal-with-presentation archeox-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"archeox-launch-floating-terminal-with-presentation archeox-sudo-passwordless"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"archeox-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"archeox-launch-config-editor ~/.config/hypr/hyprsunset.conf && archeox-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"archeox-launch-config-editor ~/.XCompose && archeox-restart-xcompose"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"archeox-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"archeox-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"archeox-launch-floating-terminal-with-presentation 'archeox-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"archeox-menu-plugin clone"},
  // Only a plugin you installed yourself can be deleted, so Remove stays
  // hidden until there is one.
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/omarchy/plugins/*/manifest.json\"","action":"archeox-menu-plugin remove"},

  // Install
  "install.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.omarchy.terminal archeox-pkg-install"},
  "install.aur": {"icon":"󰣇","label":"AUR","action":"xdg-terminal-exec --app-id=org.omarchy.terminal archeox-pkg-aur-install"},
  "install.webapp": {"icon":"","label":"Web App","action":"archeox-launch-floating-terminal-with-presentation archeox-webapp-install"},
  "install.tui": {"icon":"","label":"TUI","action":"archeox-launch-floating-terminal-with-presentation archeox-tui-install"},
  "install.service": {"icon":"","label":"Service"},
  "install.style": {"icon":"","label":"Style","target":"style.install"},
  "install.development": {"icon":"󰵮","label":"Development"},
  "install.editor": {"icon":"","label":"Editor"},
  "install.terminal": {"icon":"","label":"Terminal"},
  "install.browser": {"icon":"","label":"Browser"},
  "install.ai": {"icon":"󱚤","label":"AI"},
  "install.gaming": {"icon":"","label":"Gaming"},
  "install.windows": {"icon":"󰍲","label":"Windows","when":"[[ ! -f $HOME/.local/share/applications/windows-vm.desktop ]]","action":"archeox-launch-floating-terminal-with-presentation 'archeox-windows-vm install'"},
  "install.browser.chrome": {"icon":"","label":"Chrome","when":"! archeox-pkg-present google-chrome","action":"archeox-launch-floating-terminal-with-presentation 'archeox-install-browser chrome'"},
  "install.browser.edge": {"icon":"󰇩","label":"Edge","when":"! archeox-pkg-present microsoft-edge-stable-bin","action":"archeox-launch-floating-terminal-with-presentation 'archeox-install-browser edge'"},
  "install.browser.brave": {"icon":"","label":"Brave","when":"! archeox-pkg-present brave-bin","action":"archeox-launch-floating-terminal-with-presentation 'archeox-install-browser brave'"},
  "install.browser.brave-origin": {"icon":"","label":"Brave Origin","when":"! archeox-pkg-present brave-origin-bin","action":"archeox-launch-floating-terminal-with-presentation 'archeox-install-browser brave-origin'"},
  "install.browser.firefox": {"icon":"","label":"Firefox","when":"! archeox-pkg-present firefox","action":"archeox-launch-floating-terminal-with-presentation 'archeox-install-browser firefox'"},
  "install.browser.zen": {"icon":"󰖟","label":"Zen","when":"! archeox-pkg-present zen-browser-bin","action":"archeox-launch-floating-terminal-with-presentation 'archeox-install-browser zen'"},
  "install.service.1password": {"icon":"󰢁","label":"1Password","when":"! archeox-pkg-present 1password","action":"archeox-launch-floating-terminal-with-presentation archeox-install-service-1password"},
  "install.service.dropbox": {"icon":"","label":"Dropbox","when":"! archeox-pkg-present dropbox","action":"archeox-launch-floating-terminal-with-presentation archeox-install-service-dropbox"},
  "install.service.spotify": {"icon":"󰓇","label":"Spotify","when":"! archeox-pkg-present spotify","action":"archeox-launch-floating-terminal-with-presentation archeox-install-service-spotify"},
  "install.service.signal": {"icon":"󰭹","label":"Signal","when":"! archeox-pkg-present signal-desktop","action":"archeox-launch-floating-terminal-with-presentation archeox-install-service-signal"},
